# MEN EXCLUSIVE — environment settings
# Copy this file to .env for local development. In production, enter the same names in your host's
# environment settings (for example Vercel → Project → Settings → Environment Variables).
# Never commit real keys to the repository.

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Optional: direct (non-pooled) connection used only for migrations.
# Neon on Vercel provides this automatically as DATABASE_URL_UNPOOLED.
# DIRECT_URL=""

# ── Website address ───────────────────────────────────────────────────────────
# The public address of the site, with https and no trailing slash. Used in payment redirects and emails.
SITE_URL="http://localhost:3000"

# ── Yoco payments (Checkout API) ──────────────────────────────────────────────
# "test" simulates payments. Switch to "live" only when the live keys below are filled in.
YOCO_MODE="test"
# Secret keys: Yoco app → Sell online → Payment gateway → Checkout API → How to connect.
YOCO_TEST_SECRET_KEY=""
YOCO_LIVE_SECRET_KEY=""
# Webhook secrets: created by "npm run yoco:webhook register https://YOUR-DOMAIN/api/webhooks/yoco"
# (run once in test mode and once in live mode). Yoco shows each secret only once.
YOCO_TEST_WEBHOOK_SECRET=""
YOCO_LIVE_WEBHOOK_SECRET=""

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Order confirmations, status updates, password resets and store notifications.
# Works with any SMTP provider. For Gmail use an app password, not your normal password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MEN EXCLUSIVE <orders@your-domain.co.za>"

# ── First admin account ───────────────────────────────────────────────────────
# Created by the seed step if it does not exist yet. Use a long password and change it after first sign-in.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Scheduled clean-up ────────────────────────────────────────────────────────
# Any long random string. Protects /api/cron/expire-orders.
CRON_SECRET=""

# ── Local development only ────────────────────────────────────────────────────
# Rehearse payments without a Yoco account using "npm run yoco:mock". Ignored in live mode.
# YOCO_TEST_SECRET_KEY="sk_test_local"
# YOCO_TEST_WEBHOOK_SECRET="whsec_bG9jYWwtZGV2ZWxvcG1lbnQtb25seQ=="
# YOCO_API_BASE="http://localhost:4010"
